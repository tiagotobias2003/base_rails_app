<article id="<%= dom_id(post) %>" class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100"><%= post.title.presence || "Sem titulo" %></h3>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Autor: <span class="font-medium text-slate-700 dark:text-slate-200"><%= post.user&.email %></span>
      </p>
    </div>
    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
      <%= l(post.created_at, format: :short) %>
    </span>
  </div>

  <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-700 dark:text-slate-300"><%= post.body %></p>
</article>
